# abuseipdb-proxy configuration (environment / .env, SPEC §4).
# Copy to .env and fill in. NEVER commit .env; keep the canonical VAR=VALUE
# format (no spaces around '=' — docker --env-file is strict about it).

ABUSEIPDB_API_KEY=put-your-abuseipdb-apiv2-key-here
SCORE_THRESHOLD=30

# Optional overrides (defaults shown):
# MAX_AGE_DAYS=30
# UPSTREAM_TIMEOUT_S=5
# For tests and mocks only: the API key goes to whatever host this names.
# ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2

# Compose-only: host port published on 127.0.0.1 (SPEC §1: localhost-only).
# ABUSEIPDB_PROXY_PORT=8000

# Outbound egress proxy, when deployed behind one (standard variables,
# honored by requests — SPEC §4).
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1

# Extra CA trust, when that proxy intercepts TLS (SPEC D9): a PEM file whose
# certificates are added to the default trust. With compose, the overlay
# compose.ca.yml mounts ./ca.pem and sets this variable itself; see README,
# "Deploying behind a corporate proxy".
# CA_FILE=/path/to/proxy-ca.pem

# Python's strict X.509 checks on TLS with AbuseIPDB (SPEC D10), on by default.
# Set false only for a proxy authority that fails them; that relaxes the checks
# for every chain the service verifies. Keep the value unquoted: docker
# --env-file passes quotes through, and a quoted "false" is refused.
# X509_STRICT=true
