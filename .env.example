# abuseipdb-proxy configuration (environment / .env, SPEC §4).
# Copy to .env and fill in. NEVER commit .env; keep the canonical VAR=VALUE
# format (no spaces around '=' — docker --env-file is strict about it).

ABUSEIPDB_API_KEY=put-your-abuseipdb-apiv2-key-here
SCORE_THRESHOLD=30

# Optional overrides (defaults shown):
# MAX_AGE_DAYS=30
# UPSTREAM_TIMEOUT_S=5

# Compose-only: host port published on 127.0.0.1 (SPEC §1: localhost-only).
# ABUSEIPDB_PROXY_PORT=8000

# Outbound egress proxy, when deployed behind one (standard variables,
# honored by requests — SPEC §4). TLS-intercepting proxy: see README,
# "Deploying behind a corporate proxy" (REQUESTS_CA_BUNDLE).
# HTTPS_PROXY=http://proxy.example.internal:8080
# NO_PROXY=localhost,127.0.0.1
